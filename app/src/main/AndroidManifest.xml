<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Телефон ходит по SSH к своим машинам. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Уведомления о завершении работы агента — то, ради чего это в кармане. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Фоновая связь: без неё уведомлений не бывает вовсе — узел стоит на
         чужой машине и наружу не смотрит, push-канала в этой схеме нет. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Тумблер «уведомлять» переживает перезагрузку — служба должна тоже. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Производители Android агрессивно усыпляют фон; без исключения служба
         умирает и уведомления просто не приходят. Спрашиваем это у человека
         явно, а не молча надеемся. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".service.ReplyReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
